{
  "type": "object",
  "additionalProperties": false,
  "required": ["findings", "note"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "title",
          "file",
          "line",
          "scenario",
          "observed_result",
          "expected_result",
          "evidence",
          "confidence"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["blocker", "major", "minor", "nit"]
          },
          "title": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 0 },
          "scenario": { "type": "string" },
          "observed_result": { "type": "string" },
          "expected_result": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "line", "reason"],
              "properties": {
                "file": { "type": "string" },
                "line": { "type": "integer", "minimum": 0 },
                "reason": { "type": "string" }
              }
            }
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          }
        }
      }
    },
    "note": { "type": "string" }
  }
}
